{
  "name": "local-boston",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "bundle": "rollup -c",
    "serve": "npx http-server -p 8000 lib",
    "copy-keys-html": "cp -R lib/keys index.html dist/",
    "copy-css-otf": "cp -R lib/*.css lib/*.otf dist/",
    "build": "pnpm bundle && pnpm copy-keys-html && pnpm copy-css-otf"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "core-js": "^3.47.0",
    "http-server": "^14.1.1",
    "opaque-low-io": "^4.0.0",
    "rollup": "^4.53.3",
    "rollup-plugin-css-modules": "^0.1.2"
  },
  "dependencies": {
    "svg-data-uri": "^1.0.1",
    "esri-leaflet": "3.0.13",
    "leaflet": "1.9.4"
  },
  "pnpm": {
    "overrides": {
      "leaflet": "file:./lib/leaflet@1.9.4",
      "esri-leaflet": "file:./lib/esri-leaflet@3.0.13"
    }
  }
}
